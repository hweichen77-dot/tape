{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tape",
  "version": "1.1.0",
  "identifier": "io.github.hweichen77dot.tape",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Tape",
        "width": 1600,
        "height": 1000,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "backgroundColor": "#06080B"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Games",
    "shortDescription": "Day trading on a market that does not exist",
    "longDescription": "A day-trading game on a procedurally generated market of 6,200 invented companies. No real prices, no real money.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/hweichen77-dot/tape/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEyNTFDRjU3RkU4NzgxQjAKUldTd2dZZitWODlSb2hUME5ZVCtqNEFhb3VYZzhRTlBqSzZ0Q2FGcUNlT2F5b2lST3U3SkkvZ2IK"
    }
  }
}
